#!/bin/sh
#PBS -N tg2-attack-dev
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=24gb
#PBS -l walltime=03:00:00
#PBS -j oe

# Full 40-round, preconfirmation attack-validity runs against undefended
# hierarchical FedAvg. These development seeds may never be used for the
# twelve-seed confirmatory comparison.
set -eu
case "${TG2_SEED:?missing TG2_SEED}" in
    2001|2002|2003) ;;
    *) echo "development seed required" >&2; exit 2 ;;
esac
case "${TG2_DATASET:?missing TG2_DATASET}" in
    mnist|fashionmnist)
        TG2_MODEL=mnist_cnn ;;
    cifar10)
        TG2_MODEL=cifar_cnn ;;
    *) echo "unexpected dataset" >&2; exit 2 ;;
esac
case "${TG2_ATTACK:?missing TG2_ATTACK}" in
    unknown_patch_model_replacement|distributed_backdoor|defence_aware_optimized_trigger) ;;
    *) echo "unexpected attack" >&2; exit 2 ;;
esac

cd /home/chandrasen.pandey/tierguard2_env_2026_09_23/project_attack_dev
export PATH=/home/chandrasen.pandey/tierguard2_env_2026_09_23/shared_bin:$PATH
export PYTHONPATH=./src
export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2

../.venv/bin/python -m tierguard.cli run \
    --config configs/tierguard2/smoke.yaml \
    experiment.name=tierguard2_attack_validity_development \
    experiment.seed="$TG2_SEED" \
    experiment.device=cuda \
    experiment.rounds=40 \
    experiment.eval_every=5 \
    federated.num_clients=60 \
    federated.num_edges=6 \
    federated.clients_per_round=30 \
    federated.clients_per_edge_per_round=5 \
    federated.local_epochs=2 \
    federated.batch_size=64 \
    federated.client_lr=0.05 \
    data.dataset="$TG2_DATASET" \
    data.synthetic=false \
    data.root=/home/chandrasen.pandey/tierguard2_env_2026_09_23/datasets \
    data.train_size=null \
    data.test_size=10000 \
    data.root_dataset_size=200 \
    data.audit_search_size=200 \
    data.audit_eval_size=200 \
    data.three_way_root_split=true \
    data.partition=dirichlet \
    data.dirichlet_alpha=0.3 \
    data.iid=false \
    model.name="$TG2_MODEL" \
    attack.name="$TG2_ATTACK" \
    attack.instance_mode=deterministic \
    attack.instance_namespace=tierguard2-draft-v1 \
    attack.malicious_fraction=0.2 \
    attack.backdoor_fraction=0.3 \
    aggregation.method=hfl_fedavg \
    security.edge_challenges=true \
    provenance.require_clean_git=true
