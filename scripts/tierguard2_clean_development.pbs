#!/bin/sh
#PBS -N tg2-clean-dev
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=24gb
#PBS -l walltime=01:30:00
#PBS -j oe

# Preconfirmation development only. Submit with explicit TG2_METHOD,
# TG2_SEED and TG2_CLIP_MULT. This job cannot run confirmatory seeds.
set -eu
case "${TG2_SEED:?missing TG2_SEED}" in
    2001|2002|2003) ;;
    *) echo "development seed required" >&2; exit 2 ;;
esac
case "${TG2_METHOD:?missing TG2_METHOD}" in
    hfl_fedavg|tierguard2) ;;
    *) echo "unexpected method" >&2; exit 2 ;;
esac
case "${TG2_CLIP_MULT:?missing TG2_CLIP_MULT}" in
    8.0|16.0) ;;
    *) echo "unexpected clipping candidate" >&2; exit 2 ;;
esac
if [ "$TG2_METHOD" = hfl_fedavg ] && [ "$TG2_CLIP_MULT" != 8.0 ]; then
    echo "FedAvg has one method-independent clean setting" >&2
    exit 2
fi

cd /home/chandrasen.pandey/tierguard2_env_2026_09_23/project_dev_18945cc
export PYTHONPATH=./src
export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2

../.venv/bin/python -m tierguard.cli run \
    --config configs/tierguard2/smoke.yaml \
    experiment.name=tierguard2_clean_development_unfrozen \
    experiment.seed="$TG2_SEED" \
    experiment.device=cuda \
    experiment.rounds=40 \
    experiment.eval_every=5 \
    federated.num_clients=60 \
    federated.num_edges=6 \
    federated.clients_per_round=30 \
    federated.clients_per_edge_per_round=5 \
    federated.local_epochs=2 \
    federated.batch_size=64 \
    federated.client_lr=0.05 \
    data.dataset=fashionmnist \
    data.synthetic=false \
    data.root=/home/chandrasen.pandey/tierguard2_env_2026_09_23/datasets \
    data.train_size=null \
    data.test_size=null \
    data.root_dataset_size=200 \
    data.audit_search_size=200 \
    data.audit_eval_size=200 \
    data.three_way_root_split=true \
    data.partition=dirichlet \
    data.dirichlet_alpha=0.3 \
    data.iid=false \
    model.name=mnist_cnn \
    attack.name=none \
    attack.malicious_fraction=0.0 \
    aggregation.method="$TG2_METHOD" \
    security.edge_challenges=true \
    tierguard2.probes_per_class=2 \
    tierguard2.clip_reference_multiplier="$TG2_CLIP_MULT" \
    tierguard2.calibrated_gain_threshold=1.0
